# Copia este fichero como .env y ajusta los valores (los de aquí son ficticios)

# --- Ejecutar con `python app.py` ---
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/biblioteca
SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta

# --- Ejecutar con `docker compose up` (la DATABASE_URL la monta docker-compose.yml) ---
# Usa contraseñas sin @ : / ? # % (por ejemplo: openssl rand -hex 24)
POSTGRES_USER=biblio
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=biblioteca
